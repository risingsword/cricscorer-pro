rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // app_config: anyone can read, nobody can write
    match /app_config/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /shareLogins/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null && 
        resource.data.ownerUid == request.auth.uid;
      
      match /matches/{matchId} {
        allow read: if true;
        // New matches (including code-user scoring) may be created freely.
        allow create: if true;
        // A tombstoned match (deleted:true or deletedAt set) may only be un-deleted / changed
        // by the authenticated NON-ANONYMOUS owner (Google sign-in). Unauthenticated code users
        // — and lingering anonymous/guest sessions — can still update a LIVE match, but can NOT
        // un-delete one the owner removed. This is the server-side backstop that stops the
        // delete -> re-upload loop even for devices running an older app version.
        allow update: if (request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous')
                      || !(resource.data.deleted == true || resource.data.deletedAt != null);
        // Only the authenticated non-anonymous owner may hard-delete a match document.
        allow delete: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }
    
    // googleUsers: only own data
    match /googleUsers/{uid} {
      allow read, write: if request.auth != null && 
        request.auth.uid == uid;
        
      match /matches/{matchId} {
        allow read, write: if request.auth != null && 
          request.auth.uid == uid;
      }
    }
    
    // userCodes: only own data
    match /userCodes/{uid} {
      allow read, write: if request.auth != null && 
        request.auth.uid == uid;
    }
    
    // tournaments: organizer can write, share code read
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        resource.data.organizerUid == request.auth.uid;
    }
  }
}
